{
  "name": "poolhog",
  "version": "0.1.1",
  "description": "A connection-pool leak detector for Node.js, starting with Postgres (pg).",
  "license": "MIT",
  "keywords": [
    "postgres",
    "postgresql",
    "pg",
    "node-postgres",
    "pg-pool",
    "connection-pool",
    "connection-leak",
    "leak-detection",
    "pool-exhaustion",
    "stack-trace",
    "debugging",
    "database"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Harsh-Vaghela-404/poolhog.git"
  },
  "bugs": {
    "url": "https://github.com/Harsh-Vaghela-404/poolhog/issues"
  },
  "homepage": "https://github.com/Harsh-Vaghela-404/poolhog#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "tsc -p tsconfig.test.json --noEmit && jest",
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepublishOnly": "npm test && npm run build"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@tsconfig/node20": "^20.1.10",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.0",
    "@types/pg": "^8.23.1",
    "jest": "^30.5.2",
    "pg": "^8.23.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "pg": "^8.0.0",
    "@types/pg": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@types/pg": {
      "optional": true
    }
  }
}
